# Copy to /etc/netpan-public-search.env and chmod 600.
# Generate a URL-safe token with: openssl rand -hex 24
NODE_ENV=production
PUBLIC_SEARCH_PORT=3100
PUBLIC_SEARCH_ORIGIN=https://search.example.com
PUBLIC_SEARCH_PROXY_TOKEN=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS

# Optional in-process guardrails. The defaults are intentionally conservative.
PUBLIC_SEARCH_IP_LIMIT=20
PUBLIC_SEARCH_GLOBAL_LIMIT=120
PUBLIC_SEARCH_CONCURRENCY=4
PUBLIC_SEARCH_IP_CONCURRENCY=2
