# NetPanDownload public search reverse proxy (dedicated hostname)
#
# Install this file as a new site under sites-available and replace every
# CHANGE_ME value before enabling it. The two limit_*_zone directives are
# intentionally in this file because Debian includes site files from the
# nginx http context.

limit_req_zone $binary_remote_addr zone=netpan_public_search_per_ip:10m rate=20r/m;
limit_conn_zone $binary_remote_addr zone=netpan_public_search_conn:10m;

# HTTP-01 challenges and the HTTP-to-HTTPS redirect are kept separate from
# the existing private NetPanDownload server block.
server {
    listen 80;
    listen [::]:80;
    server_name search.example.com;
    access_log off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name search.example.com;
    access_log off;
    client_max_body_size 1k;
    limit_req_status 429;
    limit_conn_status 429;

    ssl_certificate     /etc/letsencrypt/live/search.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/search.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:NetPanPublicSearchTLS:10m;

    # The application validates this value before it trusts X-Real-IP. Keep
    # the value in this dedicated server block so clients cannot supply it.
    set $public_search_proxy_token 'CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS';

    # The application also emits these headers. Keeping them here protects
    # error responses generated by nginx itself.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy 'camera=(), microphone=(), geolocation=()' always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none';" always;

    # Never expose dot-files, runtime metadata, or alternate service paths.
    location ~ /\.(?!well-known(?:/|$)) {
        return 404;
    }

    # Public API allowlist. Exact locations deliberately keep legacy
    # /api/providers, /api/quark, /api/downloads, /api/product, /api/auth,
    # /api/download-engine, and all other private routes unreachable.
    location = /api/search {
        limit_except GET { deny all; }
        limit_req zone=netpan_public_search_per_ip burst=5 nodelay;
        limit_conn netpan_public_search_conn 4;
        proxy_pass http://127.0.0.1:3100/api/search;
        proxy_pass_request_body off;
        proxy_http_version 1.1;
        proxy_set_header Content-Length '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Public-Search-Token $public_search_proxy_token;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For '';
        proxy_connect_timeout 3s;
        proxy_send_timeout 40s;
        proxy_read_timeout 40s;
    }

    location = /api/health {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:3100/api/health;
        proxy_pass_request_body off;
        proxy_http_version 1.1;
        proxy_set_header Content-Length '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Public-Search-Token $public_search_proxy_token;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For '';
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
    }

    location = /api {
        return 404;
    }

    location ^~ /api/ {
        return 404;
    }

    # Static files and the SPA entry point are served by the isolated Node
    # process. There is no filesystem alias into the private deployment.
    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Public-Search-Token $public_search_proxy_token;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For '';
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
    }
}
