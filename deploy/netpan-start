#!/usr/bin/python3
"""Root-owned launcher; run by systemd as the unprivileged netpan user."""
import json
import os
from pathlib import Path
import re
import subprocess

root = Path('/opt/netpandownload')
current = (root / 'current').resolve(strict=True)
assert current.parent == root / 'releases' and re.fullmatch('[0-9a-f]{40}', current.name)
version = json.loads((current / 'version.json').read_text())
assert version['sha'] == current.name
assert subprocess.check_output(['/usr/bin/node', '--version'], text=True).strip() == 'v22.23.4'
os.environ['NETPAN_RELEASE_SHA'] = current.name
os.environ['QUARK_DESKTOP_ROOT'] = str(current)
os.chdir(current)
os.execv('/usr/bin/node', ['/usr/bin/node', str(current / 'dist-server/server/index.js')])
